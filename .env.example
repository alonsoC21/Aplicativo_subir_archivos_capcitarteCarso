# Base de datos (SQLite local). En produccion usar postgresql.
DATABASE_URL="file:./dev.db"

# Credenciales de administrador
ADMIN_USER="admin"
ADMIN_PASSWORD="cambiar-esta-contrasena"

# Secreto para firmar sesiones (minimo 32 caracteres aleatorios)
SESSION_SECRET="generar-secreto-aleatorio-seguro"

# Almacenamiento: local | s3
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"

# Limite de subida en bytes (10 GB por defecto)
MAX_UPLOAD_BYTES="10737418240"

# URL base publica
PUBLIC_BASE_URL="https://capacitatecarso.com"

# --- Solo cuando STORAGE_DRIVER=s3 (futuro, AWS) ---
# AWS_REGION=""
# AWS_S3_BUCKET=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
